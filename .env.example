VITE_SUPABASE_URL=your_supabase_project_url
VITE_SUPABASE_ANON_KEY=your_supabase_anon_key

# Used for uploading program videos from the Admin Panel (Programs section).
# Create an UNSIGNED upload preset in Cloudinary: Settings -> Upload -> Upload presets.
# Never put your Cloudinary API secret in this file — it must stay server-side only.
VITE_CLOUDINARY_CLOUD_NAME=your_cloudinary_cloud_name
VITE_CLOUDINARY_UPLOAD_PRESET=your_unsigned_upload_preset_name
